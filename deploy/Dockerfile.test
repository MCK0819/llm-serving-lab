FROM python:3.14.7-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /srv/llm-serving-lab

COPY requirements-dev.lock .
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-dev.lock

ENTRYPOINT ["/bin/sh", "-ec", "python -m alembic upgrade head && exec \"$@\"", "--"]
CMD ["python", "-m", "pytest", "tests/integration/test_auth.py", "-q"]
